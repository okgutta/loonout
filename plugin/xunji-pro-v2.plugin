#!name=训记 PRO 解锁 v2
#!desc=脚本版：把 fetch_policy.isgrand 改成 true、try_vip_get.vipDay 改成 36500
#!author=YG

# 说明：v1 用的是 [Rewrite] 正则改写，实测你那台机器上没有生效（抓包 155 里 isgrand 仍是 false），
# 所以 v2 改成 Loon 的 [Script] http-response 通道，这是 kelee 等主流插件用的同一条链路。

[Script]
http-response ^https?:\/\/api\.xunjiapp\.cn\/(fetch_policy|try_vip_get|have_universal_plan_v2) script-path=https://cdn.jsdelivr.net/gh/okgutta/loonout@main/scripts/xunji_pro.js,requires-body=1,max-size=1048576,tag=训记会员状态

[MITM]
hostname = api.xunjiapp.cn, trains.xunjiapp.cn, eatings.xunjiapp.cn
