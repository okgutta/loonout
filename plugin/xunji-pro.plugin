#!name=训记 PRO 解锁
#!desc=独立插件：改写 api.xunjiapp.cn 的会员状态（fetch_policy.isgrand / try_vip_get.vipDay），不依赖任何配置改动
#!author=YG
#!homepage=https://github.com/okgutta/loonout

# ─────────────────────────────────────────────
# 安装：loon://import?plugin=https://cdn.jsdelivr.net/gh/okgutta/loonout@main/plugin/xunji-pro.plugin
# 自包含：声明 MITM 主机 + 挂一个 http-response 脚本。不改主配置、不影响其他 App。
# 日志验证：Loon → 日志 → 过滤 XJ-PRO
#   [XJ-PRO] hit POST https://api.xunjiapp.cn/fetch_policy len=69
#   [XJ-PRO] out {"success":true,"res":{"isgrand":true,...}}
# ─────────────────────────────────────────────

[Script]
http-response ^https?:\/\/api\.xunjiapp\.cn\/(fetch_policy|try_vip_get|have_universal_plan_v2) script-path=https://cdn.jsdelivr.net/gh/okgutta/loonout@main/scripts/xunji_pro.js,requires-body=1,max-size=1048576,tag=训记会员状态

[MITM]
hostname = api.xunjiapp.cn
