#!name = Loon App IP Router 简易版
#!desc = 开启后自动观察目标 App；无需 START/STOP，使用 App 后点一次“查看抓取结果”。
#!author = Loon App IP Router Contributors
#!homepage = https://github.com/okgutta/loonout
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.5.0
#!tag = Loon,分流,简易
#!type = normal

[Argument]
enabled = switch,true,tag=自动抓取,desc=开启后自动记录，无需运行开始脚本
target = select,"BILIBILI","DOUYIN","NETEASE","WECHAT","WEIBO","XIAOHONGSHU","KUAISHOU","ZHIHU","TIEBA","COOLAPK","CUSTOM",tag=目标 App
custom_target = input,"CUSTOM_APP",tag=自定义 App 名称,desc=target=CUSTOM 时使用
policy = input,"IP",tag=代理策略组,desc=填写 Loon 中真实存在的策略组名称
proxy_mode = select,"CORE_MEDIA","CORE_ONLY","WHOLE_APP",tag=抓取范围,desc=默认抓核心和媒体；尽可能全部可选 WHOLE_APP

[Script]
http-request ^(?:https?|wss?):\/\/ script-path=https://raw.githubusercontent.com/okgutta/loonout/v1.1.0/easy-analyzer.js,tag=自动抓取 App 请求,timeout=20,argument=[{enabled},{target},{custom_target},{policy},{proxy_mode}],enable={enabled}
generic script-path=https://raw.githubusercontent.com/okgutta/loonout/v1.1.0/easy-report.js,tag=查看抓取结果,img-url=doc.text.magnifyingglass.system,timeout=60,argument=[{target},{custom_target},{policy},{proxy_mode}]
